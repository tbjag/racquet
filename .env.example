GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Dev defaults (localhost). In prod, set both to the public URL served by Caddy,
# e.g. https://racquet.tbjag.com/api/auth/google/callback and https://racquet.tbjag.com
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173

JWT_SECRET=change-me-in-production
DATABASE_URL=sqlite:racquet.db?mode=rwc

# Prod only: path to the built Svelte SPA served by Axum. Leave unset in dev
# (Vite serves the frontend on :5173 and proxies /api + /ws to Axum).
# STATIC_DIR=./dist
